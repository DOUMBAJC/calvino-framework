{
    "name": "calvino/framework",
    "description": "A small PHP framework for JSON APIs: router, models, migrations and a CLI.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DOUMBA Jean Calvain",
            "email": "jeancalvaindoumba07@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Calvino\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "bin": [
        "bin/calvino"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
